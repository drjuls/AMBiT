// Chromium ion - this transition metal has 5 valence electrons and is difficult to treat accurately.
// It forms part of the tutorial in the user guide as an example of a complex open-shell system.
//
// While we have kept the calculation small for the purposes of the tutorial, better accuracy could be
// achieved only on a suitable HPC (supercomputer) cluster.


ID = CrII
Z = 24

//-s123

NuclearRadius = 3.9289
NuclearThickness = 2.3

[Lattice]
NumPoints = 1000
StartPoint = 1.0e-6
EndPoint = 50.0

[HF]
N = 23
Configuration = '1s2 2s2 2p6 3s2 3p6 : 3d2 3d+3'

[Basis]
--bspline-basis
ValenceBasis = 7spdf

[CI]
LeadingConfigurations = '3d5, 3d4 4s1'
ElectronExcitations = 2
EvenParityTwoJ = '1, 3, 5'
NumSolutions = 3

[CI/SmallSide]
LeadingConfigurations = '3d5, 3d4 4s1'
ElectronExcitations = 2
ElectronBounds = '7spdf, 4spdf'

//[MBPT]
//Basis = 30spdfg

//[Transitions/E2]
//AllBelow = -9.04

//[Transitions/M1]
//MatrixElements = '1e:0->1e:1, 3e:0->5e:0'
